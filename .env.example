# Meta App Credentials (Lấy từ developers.facebook.com -> App Dashboard -> Settings -> Basic)
META_APP_ID=
META_APP_SECRET=
# Phải trùng URI đã đăng ký trong cấu hình Facebook Login của Meta App.
META_OAUTH_REDIRECT_URI=
GRAPH_API_VERSION=v26.0

# Secret Key dùng để mã hóa Page Access Token trong Database (Nếu để trống, hệ thống sẽ tự sinh khóa Fernet mới khi khởi động)
ENCRYPTION_KEY=

# Cấu hình chu kỳ bộ lập lịch (tính bằng giây)
POST_SCAN_INTERVAL_SEC=240
TASK_TICK_SEC=20
SHEET_SYNC_INTERVAL_SEC=300

# Bộ lọc chống spam và an toàn
MAX_POST_AGE_MIN=120
MIN_GAP_PER_PAGE_SEC=45
MAX_COMMENTS_PER_PAGE_PER_DAY=20
# Khoảng chờ tối đa khi Meta liên tiếp báo rate limit (Retry-After của Meta có thể dài hơn).
SEND_BACKOFF_MAX_MINUTES=30

# Múi giờ cho bộ đếm comment/ngày (7 = giờ Việt Nam, 0 = UTC)
DAILY_COUNTER_UTC_OFFSET_HOURS=7

# Tích hợp danh mục/profile Antidetect; chọn cách gửi riêng cho từng Page.
ANTIDETECT_DIR=C:\Projects\Tools\Antidetect Python
# Tự đóng trình duyệt profile sau khi thao tác xong (1 = bật)
ANTIDETECT_AUTO_CLOSE_BROWSER=1
# Cho phép quét bài qua CDP dù profile đang đóng (0 = chỉ quét khi profile đang mở)
ANTIDETECT_AUTO_SCAN_POSTS=0
# Tổng lượt mở/kiểm tra/quét/gửi qua tool, dùng chung mọi Page cùng profile.
# Lượt đã giữ vẫn tính nếu thao tác lỗi; đây không phải ngưỡng an toàn của Facebook.
BROWSER_MAX_OPERATIONS_PER_PROFILE_PER_DAY=100
BROWSER_MIN_GAP_PER_PROFILE_SEC=60

# Thiết lập cũ giữ tương thích. Run state hiện được lưu trong DB:
# DB chưa có trạng thái thì tạm dừng; DB đã có thì khôi phục trạng thái đã lưu.
PAUSED_BY_DEFAULT=1

# URL Google Sheet cho đồng bộ định kỳ. Bỏ comment để ghi đè giá trị mặc định trong config.py.
# DEFAULT_SHEET_URL=https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit?gid=<GID>

# Multi-Page comment tab URL (optional; can also be selected from the Dashboard).
# The sheet must have: ID trang | Tên Fanpage | Comment | Số phút chờ sau khi đăng
MULTI_PAGE_SHEET_URL=

# Legacy single-Page settings kept for migration from the pilot release.
PILOT_PAGE_ID=
PILOT_AUTO_SCAN=0

# Set a random secret of at least 32 characters before using the dashboard.
DASHBOARD_ADMIN_KEY=

# Tùy chọn, dùng khi người vận hành yêu cầu tạo bản nháp.
GEMINI_API_KEY=
GEMINI_MODEL=
